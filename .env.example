# 上游 Responses API 配置 (当代理收到 Chat Completions 请求时, 转发到这里)
RESPONSES_API_BASE_URL=https://your-responses-api.com
RESPONSES_API_KEY=sk-your-responses-api-key

# 上游 Chat Completions API 配置 (当代理收到 Responses 请求时, 转发到这里)
COMPLETIONS_API_BASE_URL=https://api.openai.com
COMPLETIONS_API_KEY=sk-your-openai-key-here

# 代理服务器配置
HOST=0.0.0.0
PORT=9090

# 推理缓存配置
CACHE_DIR=cache

# 透传模式配置 (启用后请求不做格式转换, 直接透传到上游 Responses API)
TRANSPARENT_ENABLED=false

# 模型映射启用开关 (默认 true, 可分别控制两种模式)
MODEL_MAP_TRANSPARENT_ENABLED=true
MODEL_MAP_CONVERT_ENABLED=true

# 模型映射配置 (强制替换请求模型, 客户端无感知)
# 格式: 多行 JSON 对象, key=客户端模型, value=实际上游模型
MODEL_MAP={
  "gpt-5.3-codex": "mimo-v2.5",
  "gpt-5.4": "mimo-v2.5",
  "gpt-5.4-mini": "mimo-v2.5",
  "gpt-5.5": "mimo-v2.5",
  "gpt-5.4-pro": "mimo-v2.5-pro",
  "gpt-5.5-pro": "mimo-v2.5-pro"
}

# 推理强度映射启用开关 (默认 true, 可分别控制两种模式)
REASONING_EFFORT_MAP_TRANSPARENT_ENABLED=true
REASONING_EFFORT_MAP_CONVERT_ENABLED=true

# 推理强度映射 (将客户端的 reasoning_effort 强制重写为上游支持的值)
# 格式: 多行 JSON, key=客户端值, value=上游实际值
# 未列出的值 (如 low/medium/high) 原样透传, 仅命中 key 的值会被替换
REASONING_EFFORT_MAP={
  "xhigh": "high"
}
